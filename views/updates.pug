doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        p
            a(href="/") Return to the homepage
        .form-wrapper
            h1 Add Freezer Item
            form(action="/update-cobj" method="POST")
                label(for="item_name") Name
                input(type="text" id="item_name" name="item_name" required)

                label(for="date_frozen") Date Frozen
                input(type="text" id="date_frozen" name="date_frozen" required)

                label(for="location_description") Location
                input(type="text" id="location_description" name="location_description" required)

                input(type="submit" value="Add Item")
